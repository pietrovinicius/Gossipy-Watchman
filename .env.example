# Segurança JWT
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=TROQUE-ESTE-VALOR-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Admin
# Gere com: python -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('watchman'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Upload
MAX_UPLOAD_SIZE_MB=500

# Banco
DATABASE_URL=sqlite:///./gossipy.db

# Storage
STORAGE_VIDEOS=storage/videos
STORAGE_FACES=storage/faces

# Visão computacional
FACE_RECOGNITION_TOLERANCE=0.6
FRAMES_PER_SECOND_SAMPLE=1

# App
APP_NAME=Gossipy Watchman
APP_VERSION=1.1.0
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
