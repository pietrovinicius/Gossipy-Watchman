# Segurança JWT
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=TROQUE-ESTE-VALOR-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Admin
# Gere com: python -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('watchman'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Upload
MAX_UPLOAD_SIZE_MB=5120

# Banco
DATABASE_URL=sqlite:///./gossipy.db

# Storage
STORAGE_VIDEOS=storage/videos
STORAGE_FACES=storage/faces

# Visão computacional
FACE_RECOGNITION_TOLERANCE=0.6
FRAMES_PER_SECOND_SAMPLE=2
# Detecção de faces
# Modelo: "hog" (rápido) ou "cnn" (preciso — recomendado)
FACE_DETECTION_MODEL=cnn
# Upsample: 0=rápido, 1=padrão, 2=detecta faces menores
FACE_UPSAMPLE=1

# App
APP_NAME=Gossipy Watchman
APP_VERSION=1.7.0
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true

# ffmpeg — conversão automática de vídeos
FFMPEG_PATH=ffmpeg

# CNN adaptativo por duração do vídeo
CNN_ADAPTIVE_SHORT_MAX=600
CNN_ADAPTIVE_MEDIUM_MAX=3600
CNN_SHORT_UPSAMPLE=2
CNN_SHORT_FPS_SAMPLE=2
CNN_MEDIUM_UPSAMPLE=1
CNN_MEDIUM_FPS_SAMPLE=2
CNN_LONG_UPSAMPLE=1
CNN_LONG_FPS_SAMPLE=1
